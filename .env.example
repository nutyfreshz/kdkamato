# Existing content control sheet created for KDKAMATO Website.
KDKAMATO_WEB_CONTENT_SHEET_ID=1GA2U8TzHjjUmdE0cTgpKYZ0g0ZnvjadO93nzf1gtsn0

# Google service account used only by the Vercel server runtime.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Site reads only this status in production. Recommended: PUBLISHED.
KDKAMATO_CONTENT_STATUS=PUBLISHED

# PRO Consult owner console. This value is not secret, but only this authenticated email can open /pro-consult.
KDKAMATO_PRO_ADMIN_EMAIL=brosci.bnbh@gmail.com

# Supabase Edge Function (kdk-consult-email) secrets/config.
# Configure these in Supabase Edge Function secrets, not in client-side environment variables.
RESEND_API_KEY=re_xxxxxxxxx
KDKAMATO_EMAIL_FROM="KDKAMATO Consult <consult@kdkamato.com>"
KDKAMATO_SITE_URL=https://kdkamato.vercel.app
